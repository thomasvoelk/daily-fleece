{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "NODE_OPTIONS=\"--throw-deprecation --require ./scripts/deprecation-filter.cjs\" ng serve",
    "build": "NODE_OPTIONS=\"--throw-deprecation --require ./scripts/deprecation-filter.cjs\" ng build && npm run lint",
    "watch": "NODE_OPTIONS=\"--throw-deprecation --require ./scripts/deprecation-filter.cjs\" ng build --watch --configuration development",
    "test": "NODE_OPTIONS=\"--throw-deprecation --require ./scripts/deprecation-filter.cjs\" ng test",
    "lint": "eslint src/ --max-warnings=0",
    "generate:api": "ng-openapi-gen",
    "prebuild": "ng-openapi-gen",
    "prestart": "ng-openapi-gen"
  },
  "private": true,
  "overrides": {
    "eslint": "10.4.1"
  },
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular-architects/ngrx-toolkit": "21.0.1",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.16",
    "@angular/compiler": "21.2.16",
    "@angular/core": "21.2.16",
    "@angular/forms": "21.2.16",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.16",
    "@angular/router": "21.2.16",
    "@ngrx/signals": "21.1.1",
    "@tailwindcss/postcss": "4.3.0",
    "rxjs": "7.8.2",
    "tailwindcss": "4.3.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.14",
    "@angular/cli": "21.2.14",
    "@angular/compiler-cli": "21.2.16",
    "@angular/localize": "21.2.16",
    "@eslint/js": "10.0.1",
    "@softarc/eslint-plugin-sheriff": "0.19.6",
    "@softarc/sheriff-core": "0.19.6",
    "@testing-library/angular": "19.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.1",
    "angular-eslint": "21.4.0",
    "axe-core": "4.12.0",
    "eslint": "10.4.1",
    "eslint-plugin-rxjs-x": "1.0.2",
    "eslint-plugin-sonarjs": "4.0.3",
    "eslint-plugin-tailwindcss": "4.0.0-alpha.5",
    "jsdom": "28.1.0",
    "ng-openapi-gen": "1.0.5",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.0",
    "vitest": "4.1.8"
  }
}
